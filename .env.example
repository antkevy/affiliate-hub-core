# ─────────────────────────────────────────────────────────────
# Affiliate Hub — variáveis de ambiente
# Copie para .env com valores reais. NUNCA comite .env contendo
# segredos (service role, cron, IA) — só chaves públicas ficam no repo.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"

# Vite Environment Variables (exposed to client)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ── Server-only (definir no Lovable Cloud, NÃO no .env commitado) ──
# Chave de service role do Supabase. Necessária para os jobs de
# publicação automática (server-side, rompe RLS).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Segredo usado pelo cron para autenticar /api/scheduled/run
# (Authorization: Bearer <PUBLISH_CRON_SECRET>).
PUBLISH_CRON_SECRET="troque-por-um-valor-forte"

# Quando o job é gerenciado pelo próprio Lovable, ele injeta estas
# automaticamente (não precisam ser definidas por você):
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""

# ── IA (opcional, usado quando a automação tem IA habilitada) ──
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"